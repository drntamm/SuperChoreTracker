{
    "version": 2,
    "name": "super-chore-tracker",
    "builds": [
        {
            "src": "api/*.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/$1"
        },
        {
            "src": "^/(?!api|.*\\.[^/]+$)(.*?)/?$",
            "dest": "/index.html"
        }
    ]
}