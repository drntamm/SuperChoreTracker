{
    "version": 2,
    "name": "super-chore-tracker",
    "builds": [
        {
            "src": "index.html",
            "use": "@vercel/static"
        },
        {
            "src": "api/*.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/$1"
        },
        {
            "src": "/(?!api).*\\.(css|js|png|jpg|jpeg|svg|gif|ico|json)$",
            "dest": "/$0"
        },
        {
            "src": "/(.*)",
            "dest": "index.html"
        }
    ]
}